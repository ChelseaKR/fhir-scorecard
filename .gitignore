.venv/
__pycache__/
*.egg-info/
.coverage
site/
.hypothesis/
.cache/

# Agent worktrees are scratch checkouts, never repository content.
.claude/

# Terraform: local plan/init state and the packaged Lambda zip never belong in git. The lock
# file (.terraform.lock.hcl) is the exception and stays tracked.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.zip
infra/**/build/
# Written by scripts/stripe-setup.sh and `terraform plan -out`; local to the owner's machine.
infra/**/terraform.tfvars
infra/**/tfplan
infra/**/*.tfplan
